# Application Settings
APP_NAME="Zimnat PM Tool"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE="Africa/Harare"

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=zpm_tool
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session Configuration
SESSION_NAME=zpm_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# Security
BCRYPT_ROUNDS=12

# File Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES="xlsx,xls,csv"

# Governance Attachments
GOVERNANCE_UPLOAD_PATH="uploads/governance"
GOVERNANCE_MAX_UPLOAD_SIZE=10485760
GOVERNANCE_ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,png,jpg,jpeg"

# Stakeholder Requirement Documents
STAKEHOLDER_UPLOAD_PATH="uploads/stakeholders"
STAKEHOLDER_MAX_UPLOAD_SIZE=10485760
STAKEHOLDER_ALLOWED_FILE_TYPES="pdf,doc,docx,txt"

# SMTP / Notifications
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com

# Weekly digest recipients (comma-separated). Falls back to ADMIN_EMAIL if unset.
DIGEST_RECIPIENTS=