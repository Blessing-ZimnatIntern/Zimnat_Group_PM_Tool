{
    "name": "zimnat/pm-tool",
    "description": "Zimnat Group Project Management Tool",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6.3",
        "phpoffice/phpspreadsheet": "^2.1.17"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Copy .env.example to .env and configure your database'"
        ],
        "test": "phpunit",
        "start": "php -S localhost:8000 -t public"
    }
}